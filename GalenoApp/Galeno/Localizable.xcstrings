    "connect.nameConflict.body %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I won’t touch it. The usual choice is for Galeno to use its own name (“galeno-%@”) and leave yours as it is. Or, if you prefer, I can delete yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No lo toco. Lo normal es que Galeno use su propio nombre («galeno-%@») y el tuyo siga como está. O, si prefieres, puedo borrar el tuyo."
          }
        }
      }
    },
