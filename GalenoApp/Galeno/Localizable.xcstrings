    "connect.nameConflict.title %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have a different server called “%@” in Claude Code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes en Claude Code otro servidor llamado «%@»."
          }
        }
      }
    },
    "connect.nameConflict.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I won't touch it. The usual choice is for Galeno to use its own name (starting with “galeno-”) and leave yours as it is. Or, if you prefer, I can delete yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No lo toco. Lo normal es que Galeno use su propio nombre (con «galeno-» delante) y el tuyo siga como está. O, si prefieres, puedo borrar el tuyo."
          }
        }
      }
    },
    "connect.nameConflict.useOther" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use another name"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar otro nombre"
          }
        }
      }
    },
    "connect.nameConflict.remove" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete the existing one…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar el existente…"
          }
        }
      }
    },
    "connect.removal.title %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete the “%@” server from Claude Code?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Borrar el servidor «%@» de Claude Code?"
          }
        }
      }
    },
    "connect.removal.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its configuration is removed from Claude Code, and it stops being available in all your projects. If you need it later, you'll have to add it again. Nothing in the tool itself is deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borra su configuración en Claude Code, y deja de estar disponible en todos tus proyectos. Si lo necesitas más adelante, tendrás que volver a añadirlo. No se borra nada de la herramienta en sí."
          }
        }
      }
    },
    "connect.removal.cancel" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never mind"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor no"
          }
        }
      }
    },
    "connect.removal.confirm %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes, delete “%@”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí, borrar «%@»"
          }
        }
      }
    },
