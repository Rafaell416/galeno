      }
    },
    "connect.whatsapp.warning.body" : {
      "comment" : "TEXTO PROTEGIDO (docs/03 §4, AGENTS.md): no editar sin aprobación de Rafa. El español es el de la spec, literal; la traducción al inglés la aprueba Rafa. Sin 'seguro' ni 'oficial' (línea roja 9).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This connects as a linked device using the WhatsApp Web protocol, in an unofficial way. It is read-only. There is a low but real risk that WhatsApp detects it and restricts your account. Everything runs on your computer; nothing goes to our servers. You decide whether to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto se conecta como un dispositivo vinculado usando el protocolo de WhatsApp Web, de forma no oficial. Es de solo lectura. Existe un riesgo bajo pero real de que WhatsApp lo detecte y restrinja tu cuenta. Todo corre en tu computador; nada sale a servidores nuestros. Tú decides si continuar."
          }
        }
      }
    },
    "connect.whatsapp.warning.title" : {
