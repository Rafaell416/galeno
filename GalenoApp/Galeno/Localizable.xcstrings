    "connect.slack.authorize.userTurn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in if asked, then press “Allow” so Galeno can read your Slack. This window closes by itself when done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te lo pide, inicia sesión; luego pulsa «Permitir» para que Galeno pueda leer tu Slack. Esta ventana se cierra sola al terminar."
          }
        }
      }
    },
