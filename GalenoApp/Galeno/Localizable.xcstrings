      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One last thing: give your Slack app a face"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un último detalle: ponle cara a tu app de Slack"
          }
