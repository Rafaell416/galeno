    "connect.failure.slackAppMissing" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack no longer recognizes the app Galeno created for your workspace (was it deleted?). Galeno can create it again: it will remove the “slack” connection in Claude Code that pointed to the deleted app and ask you to sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack ya no reconoce la app que Galeno creó para tu workspace (¿la borraste?). Galeno puede crearla de nuevo: quitará de Claude Code la conexión «slack» que apuntaba a la app borrada y te pedirá iniciar sesión otra vez."
          }
        }
      }
    },
