            "value" : "The first time can take a few minutes. You can carry on without waiting: syncing continues in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez puede tardar unos minutos. Puedes seguir sin esperar: la sincronización continúa en segundo plano."
