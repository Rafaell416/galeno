    "help.connect.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack requires the connection to go through an app in your own account. First we create it with you, then you authorize it with “Allow”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack pide que la conexión pase por una app creada en tu cuenta. Primero la creamos contigo y después la autorizas con «Permitir»."
          }
        }
      }
    },
    "help.connect.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why do I sign in twice to Slack?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué inicio sesión dos veces en Slack?"
          }
        }
      }
    },
    "help.connect.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can try again, or skip that tool and connect it later. Nothing is left half-done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes reintentar, o saltar esa herramienta y conectarla después. Nada queda a medias."
          }
        }
      }
    },
    "help.connect.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if something fails?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué pasa si algo falla?"
          }
        }
      }
    },
    "help.connect.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. You sign in on each service’s own page; Galeno doesn’t read or store passwords, and the Slack session is erased when its window closes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Inicias sesión en la página de cada servicio; Galeno no lee ni guarda contraseñas, y la sesión de Slack se borra al cerrar su ventana."
          }
        }
      }
    },
    "help.connect.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does Galeno see my password?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Galeno ve mi contraseña?"
          }
        }
      }
    },
    "help.detection.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic’s app where your agent lives. Galeno sets it up; Claude Code runs it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación de Anthropic donde vive tu agente. Galeno lo prepara; Claude Code lo ejecuta."
          }
        }
      }
    },
    "help.detection.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is Claude Code?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué es Claude Code?"
          }
        }
      }
    },
    "help.detection.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because installing programs is your call. Galeno only shows you the official command and you paste it into Terminal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porque instalar programas es decisión tuya. Galeno solo te muestra el comando oficial y lo pegas tú en Terminal."
          }
        }
      }
    },
    "help.detection.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why doesn’t Galeno install it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué Galeno no lo instala?"
          }
        }
      }
    },
    "help.detection.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use your agent, yes. You can continue without it for now, but you will need to sign in before asking it anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar a tu agente, sí. Puedes continuar sin ella ahora, pero tendrás que entrar antes de pedirle algo."
          }
        }
      }
    },
    "help.detection.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do I need to be signed in?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Necesito tener la sesión iniciada?"
          }
        }
      }
    },
    "help.done.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open it in the Claude app or in Terminal and write to it, for example with the suggested command."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ábrelo en la app de Claude o en Terminal y escríbele, por ejemplo con el comando sugerido."
          }
        }
      }
    },
    "help.done.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do I talk to my agent?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo hablo con mi agente?"
          }
        }
      }
    },
    "help.done.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a folder with its name inside ~/Galeno. Inside are its AGENTS.md and its memoria/ folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una carpeta con su nombre dentro de ~/Galeno. Dentro están su AGENTS.md y su carpeta memoria/."
          }
        }
      }
    },
    "help.done.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where does it live?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde quedó?"
          }
        }
      }
    },
    "help.done.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes: “Back” takes you to the review and, moving on, the same agent is rewritten without creating another. memoria/ is not touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí: «Atrás» te lleva a la revisión y, al avanzar, se reescribe el mismo agente sin crear otro. memoria/ no se toca."
          }
        }
      }
    },
    "help.done.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I change something later?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puedo cambiar algo después?"
          }
        }
      }
    },
    "help.review.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not until you press “Write …”. Before that you can change any block."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hasta que pulses «Escribir a …». Antes puedes cambiar cualquier bloque."
          }
        }
      }
    },
    "help.review.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is anything written now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se escribe algo ahora?"
          }
        }
      }
    },
    "help.review.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They live in Claude Code and aren’t touched: only the agent’s folder is written."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viven en Claude Code y no se tocan: solo se escribe la carpeta del agente."
          }
        }
      }
    },
    "help.review.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What happens to my connections?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué pasa con mis conexiones?"
          }
        }
      }
    },
    "help.review.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tools you ticked but didn’t connect. You can connect them later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herramientas que marcaste pero no conectaste. Puedes conectarlas más adelante."
          }
        }
      }
    },
    "help.review.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is “For later”?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué es «Para después»?"
          }
        }
      }
    },
    "help.rules.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Anything that goes out to other people (Slack, email) needs your approval, and that can’t be changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Todo lo que sale hacia otras personas (Slack, correo) pide tu aprobación, y eso no se puede cambiar."
          }
        }
      }
    },
    "help.rules.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can my agent send messages without asking me?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puede mi agente enviar mensajes sin pedirme permiso?"
          }
        }
      }
    },
    "help.rules.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That the agent creates and edits inside your tools (Notion, Jira…) without telling you first. A draft can be fixed; choose by how much you trust it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que el agente cree y edite dentro de tus herramientas (Notion, Jira…) sin avisarte antes. Un borrador se corrige; elige según tu confianza."
          }
        }
      }
    },
    "help.rules.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What does “Don’t ask” change?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué cambia «Sin preguntar»?"
          }
        }
      }
    },
    "help.rules.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only in its memoria/ folder, where it keeps the project notes. It doesn’t run code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en su carpeta memoria/, donde guarda las notas del proyecto. No ejecuta código."
          }
        }
      }
    },
    "help.rules.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where does it write on my computer?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde escribe en mi computador?"
          }
        }
      }
    },
    "help.skills.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A named task your agent runs when you type its command, for example /prd."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tarea con nombre que tu agente ejecuta cuando escribes su comando, por ejemplo /prd."
          }
        }
      }
    },
    "help.skills.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is a skill?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué es una skill?"
          }
        }
      }
    },
    "help.skills.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They need a tool you didn’t connect. They are useful once you have it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitan una herramienta que no conectaste. Sirven cuando la tengas."
          }
        }
      }
    },
    "help.skills.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why are some dimmed?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué algunas salen atenuadas?"
          }
        }
      }
    },
    "help.skills.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skills by other people that we reviewed. Each one carries its author’s credit; for now they are only shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skills de otras personas que revisamos nosotros. Cada una lleva el crédito de su autor; por ahora solo se ven."
          }
        }
      }
    },
    "help.skills.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What are the curated ones?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué son las curadas?"
          }
        }
      }
    },
    "help.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questions about this step"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dudas de este paso"
          }
        }
      }
    },
    "help.tools.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No, only the ones you use. Each one is connected separately in the next step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No, solo las que usas. Cada una se conecta por separado en el paso siguiente."
          }
        }
      }
    },
    "help.tools.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do I have to tick them all?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tengo que marcar todas?"
          }
        }
      }
    },
    "help.tools.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because its recordings live in Google Drive: reading them takes Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porque sus grabaciones viven en Google Drive: para leerlas hace falta Drive."
          }
        }
      }
    },
    "help.tools.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why is Google Meet ticked automatically?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué Google Meet se marca solo?"
          }
        }
      }
    },
    "help.tools.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never. WhatsApp is read-only: the code to send messages does not exist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca. WhatsApp es de solo lectura: el código para enviar mensajes no existe."
          }
        }
      }
    },
    "help.tools.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can the agent write on WhatsApp?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puede el agente escribir en WhatsApp?"
          }
        }
      }
    },
    "help.welcome.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Between 10 and 15 minutes; most of it is connecting your tools. You can close the app and carry on later: what you chose is saved on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre 10 y 15 minutos; casi todo es conectar tus herramientas. Puedes cerrar la app y seguir después: lo que elegiste queda guardado en este Mac."
          }
        }
      }
    },
    "help.welcome.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long does it take?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuánto tarda?"
          }
        }
      }
    },
    "help.welcome.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Everything happens on this Mac. Claude Code makes the connections and it, not Galeno, keeps the access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Todo ocurre en este Mac. Las conexiones las hace Claude Code y los accesos los guarda él, no Galeno."
          }
        }
      }
    },
    "help.welcome.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does Galeno store my data on a server?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Galeno guarda mis datos en algún servidor?"
          }
        }
      }
    },
    "help.welcome.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes, while you go through the setup. Your agent is written in whichever language you have chosen at the end."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí, mientras sigues el asistente. Tu agente se escribe en el idioma que tengas elegido al final."
          }
        }
      }
    },
    "help.welcome.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I change the language later?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puedo cambiar el idioma después?"
          }
        }
      }
    },
