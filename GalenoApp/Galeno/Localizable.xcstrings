    "connect.ownApp.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack and Google require the connection to go through an app created in your own account, so nothing goes through our servers. Galeno will create it for you in an upcoming update; for now it stays for later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack y Google piden que la conexión pase por una app creada en tu propia cuenta, para que nada pase por servidores nuestros. Galeno la creará por ti en una próxima actualización; por ahora queda para después."
          }
        }
      }
    },
