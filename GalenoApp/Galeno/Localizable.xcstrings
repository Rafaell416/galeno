    "connect.failure.tokenRejected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack didn't accept that token. It may have expired (they last 12 hours) or be the wrong one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack no aceptó ese token. Puede haber vencido (duran 12 horas) o no ser el correcto."
          }
        }
      }
    },
    "connect.failure.what.browser" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What to do: try again; if the browser doesn’t open, check that pop-ups aren’t blocked. You can skip it and connect it later from the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué hacer: vuelve a intentarlo; si el navegador no se abre, revisa que no esté bloqueando ventanas emergentes. Puedes saltarlo y conectarlo después desde la app."
          }
        }
      }
    },
    "connect.failure.what.generic" : {
      "extractionState" : "manual",
      "localizations" : {
