    "context.privacy %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays on your Mac, in %@’s folder. Don’t paste passwords or keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se queda en tu Mac, en la carpeta de %@. No pegues contraseñas ni claves."
          }
        }
      }
    },
    "context.prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I want to hand the context of this project to a new agent that will work with me in Claude Code. Using everything you know about this project (this conversation, the project and its files), write a Markdown document with these sections: goal and current status; key people and their role; decisions made and why; open items and dates; terms or acronyms specific to the project; where everything lives (documents, boards, channels). Be concrete and don’t make things up: if you don’t know something, write “I don’t know”. Don’t include passwords, keys or access details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiero pasarle el contexto de este proyecto a un agente nuevo que trabajará conmigo en Claude Code. Con todo lo que sabes de este proyecto (esta conversación, el proyecto y sus archivos), escribe un documento en Markdown con estas secciones: objetivo y estado actual; personas clave y su rol; decisiones tomadas y por qué; pendientes y fechas; términos o siglas propios del proyecto; dónde vive cada cosa (documentos, tableros, canales). Sé concreto y no inventes: si algo no lo sabes, escribe «No sé». No incluyas contraseñas, claves ni datos de acceso."
          }
        }
      }
    },
