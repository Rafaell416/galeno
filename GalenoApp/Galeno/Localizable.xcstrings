          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué son las curadas?"
          }
        }
      }
    },
    "help.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questions about this step"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dudas de este paso"
          }
        }
      }
    },
    "help.tools.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No, only the ones you use. They are connected one by one, in the order you see."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No, solo las que usas. Se conectan una por una, en el orden que ves."
          }
        }
      }
    },
    "help.tools.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do I have to tick them all?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tengo que marcar todas?"
          }
        }
      }
    },
    "help.tools.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They are the ones most used in your role. Untick the ones you do not use and tick the ones you do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son las que más se usan en tu rol. Desmarca las que no uses y marca las que sí."
          }
        }
      }
    },
    "help.tools.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why are three already ticked?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué vienen tres marcadas?"
          }
        }
      }
    },
    "help.tools.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes, only when you approve each message. It writes text to one person or to a group you are already in; never to broadcast lists or statuses, and never in a scheduled run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí, solo cuando tú apruebas cada mensaje. Escribe texto a una persona o a un grupo en el que ya estás; nunca a listas de difusión ni a estados, y nunca en una tarea programada."
          }
        }
      }
    },
    "help.tools.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can the agent write on WhatsApp?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puede el agente escribir en WhatsApp?"
          }
        }
      }
    },
    "help.context.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is this required?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Es obligatorio?"
          }
        }
      }
    },
    "help.context.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. You can carry on without writing anything: your agent learns about the project by reading your tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Puedes seguir sin escribir nada: tu agente aprende del proyecto leyendo tus herramientas."
          }
        }
      }
    },
    "help.context.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which files work?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué archivos sirven?"
          }
        }
      }
    },
    "help.context.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF, .md or .txt up to 5 MB: a brief, a plan, project notes. Up to ten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF, .md o .txt de hasta 5 MB: un brief, un plan, notas del proyecto. Hasta diez."
          }
        }
      }
    },
    "help.context.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where do they go?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿A dónde van?"
          }
        }
      }
    },
    "help.context.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To your agent’s folder on this Mac. It reads them in its first session and shows you a summary to correct."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la carpeta de tu agente en este Mac. Los lee en su primera sesión y te muestra un resumen para que lo corrijas."
          }
        }
      }
    },
