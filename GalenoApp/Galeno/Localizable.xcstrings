    "connect.failure.nameInUse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can't use the alternate name either: another server with that name already exists in Claude Code. Rename or delete it from Claude Code and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampoco puedo usar el nombre alternativo: ya hay otro servidor con ese nombre en Claude Code. Renómbralo o bórralo desde Claude Code y reintenta."
          }
        }
      }
    },
    "connect.failure.notAuthorizedInTime" : {
