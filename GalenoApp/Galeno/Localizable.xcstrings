    "connect.slackDetails.icon" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload an icon: an image between 512 × 512 and 2000 × 2000 pixels, ideally square. Slack rejects it if it's smaller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube un icono: una imagen de entre 512 × 512 y 2000 × 2000 píxeles, mejor cuadrada. Slack no la acepta si es más pequeña."
          }
        }
      }
    },
    "connect.slackDetails.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the description: the short one takes up to 140 characters, the long one 174 to 4000. It's what your admin sees when approving the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la descripción: la corta admite hasta 140 caracteres y la larga, entre 174 y 4000. Es lo que ve tu administrador al aprobar la app."
          }
        }
      }
    },
    "connect.slackDetails.where" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
