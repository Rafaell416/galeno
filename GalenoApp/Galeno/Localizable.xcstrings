    "connect.failure.slackAppMissing" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack no longer recognizes the app Galeno created for your workspace (was it deleted?). Galeno can create it again: it will remove the “slack” connection in Claude Code that pointed to the deleted app and ask you to sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack ya no reconoce la app que Galeno creó para tu workspace (¿la borraste?). Galeno puede crearla de nuevo: quitará de Claude Code la conexión «slack» que apuntaba a la app borrada y te pedirá iniciar sesión otra vez."
          }
        }
      }
    },
    "connect.failure.slackMCPNotEnabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack accepted the authorization, but the app doesn't have the MCP server turned on. Turn it on in the app's page (“Agents & AI Apps” → Slack Model Context Protocol (MCP) Server) and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack aceptó la autorización, pero la app no tiene activado el servidor MCP. Actívalo en la página de la app («Agents & AI Apps» → Slack Model Context Protocol (MCP) Server) y reintenta."
          }
        }
      }
    },
    "connect.failure.slackManifest" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack rejected the app's configuration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack rechazó la configuración de la app."
          }
        }
      }
    },
    "connect.failure.slackNotAllowed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack didn't let you create the app. You most likely need a workspace admin's approval."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack no te dejó crear la app. Casi seguro hace falta la aprobación de un administrador de tu workspace."
          }
        }
      }
    },
    "connect.failure.slackUnreachable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I couldn't reach Slack. Check your internet connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pude hablar con Slack. Revisa tu conexión a internet."
          }
        }
      }
    },
