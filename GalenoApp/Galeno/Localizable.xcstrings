{
  "sourceLanguage": "en",
  "strings": {
    "step.agent.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pones nombre a tu agente y una línea sobre el proyecto en el que va a trabajar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You name your agent and add one line about the project it will work on."
          }
        }
      }
    },
    "step.agent.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu agente"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agent"
          }
        }
      }
    },
    "step.connect.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectamos cada herramienta en su propia pantalla, con un dato real de lo que encontramos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We connect each tool on its own screen, with a real figure of what we found."
          }
        }
      }
    },
    "step.connect.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una por una"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect them one by one"
          }
        }
      }
    },
    "step.detection.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobamos que Claude Code esté instalado; si no, te guiamos para instalarlo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We check that Claude Code is installed; if it is not, we guide you through installing it."
          }
        }
      }
    },
    "step.detection.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectar Claude Code"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect Claude Code"
          }
        }
      }
    },
    "step.done.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo usar tu agente, primeros comandos y dónde quedó su carpeta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to use your agent, first commands and where its folder is."
          }
        }
      }
    },
    "step.done.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "step.generating.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribimos la configuración de tu agente, paso a paso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We write your agent's configuration, step by step."
          }
        }
      }
    },
    "step.generating.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generando"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building"
          }
        }
      }
    },
    "step.rules.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Defines qué puede hacer tu agente sin preguntar y qué siempre pide aprobación."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide what your agent may do without asking and what always needs approval."
          }
        }
      }
    },
    "step.rules.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglas"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules"
          }
        }
      }
    },
    "step.skills.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuestras, marcadas por defecto, y las curadas de la comunidad, con crédito a su autor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ours, ticked by default, and the community's curated ones, credited to their authors."
          }
        }
      }
    },
    "step.skills.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tus skills"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your skills"
          }
        }
      }
    },
    "step.sources.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliges los grupos, canales, carpetas y proyectos en los que tu agente se enfoca."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You choose the groups, channels, folders and projects your agent focuses on."
          }
        }
      }
    },
    "step.sources.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué leer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what to read"
          }
        }
      }
    },
    "step.tools.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcas solo las herramientas que usas: WhatsApp, Slack, Notion, Google, Jira, Gmail y las de reuniones."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You tick only the tools you use: WhatsApp, Slack, Notion, Google, Jira, Gmail and the meeting tools."
          }
        }
      }
    },
    "step.tools.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tus herramientas"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your tools"
          }
        }
      }
    },
    "step.welcome.summary": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliges el idioma y te cuento qué vamos a configurar y cuánto tarda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You choose the language, and I tell you what we will set up and how long it takes."
          }
        }
      }
    },
    "step.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma y bienvenida"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language and welcome"
          }
        }
      }
    },
    "wizard.back": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrás"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        }
      }
    },
    "wizard.finish": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish"
          }
        }
      }
    },
    "wizard.next": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiente"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        }
      }
    },
    "wizard.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla está en construcción."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen is under construction."
          }
        }
      }
    },
    "wizard.progress.label": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Progreso del asistente"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wizard progress"
          }
        }
      }
    },
    "wizard.progress.step %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso %1$lld de %2$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$lld of %2$lld"
          }
        }
      }
    }
  },
  "version": "1.0"
}
