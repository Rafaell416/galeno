    "agent.account.issue.nameInUse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code already has a server with that name that Galeno did not create, and Galeno does not touch it. Pick a different name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code ya tiene un servidor con ese nombre que Galeno no creó, y Galeno no lo toca. Elige otro nombre."
          }
        }
      }
    },
    "agent.account.issue.couldNotRegister" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code did not accept the account. Try again; if it keeps failing, check that Claude Code is up to date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code no aceptó la cuenta. Inténtalo de nuevo; si sigue fallando, revisa que Claude Code esté al día."
          }
        }
      }
    },
    "agent.account.issue.notAuthorizedInTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account was not authorized in time. Try again and finish in your browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta no se autorizó a tiempo. Inténtalo de nuevo y termina en tu navegador."
