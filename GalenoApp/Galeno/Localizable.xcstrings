    "help.agent.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because you will read it on every screen and in every reply. A proper name makes it easier to talk to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porque lo vas a leer en cada pantalla y en cada respuesta. Un nombre propio hace más fácil hablarle."
          }
        }
      }
    },
    "help.agent.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why give it a name?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué le pongo nombre?"
          }
        }
      }
    },
    "help.agent.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is the only role in this version. More will come later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el único rol de esta versión. Más adelante habrá otros."
          }
        }
      }
    },
    "help.agent.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why only Product Manager?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué solo Product Manager?"
          }
        }
      }
    },
    "help.agent.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One line is enough: your agent fills in the rest in its first session, by reading your tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una línea basta: tu agente completa el resto en su primera sesión, leyendo tus herramientas."
          }
        }
      }
    },
    "help.agent.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What do I write for the project?"
