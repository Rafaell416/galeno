    "health.whatsapp.syncHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without the background service no new messages arrive and nothing you approve goes out. Restart it from here; if that is not enough, link again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin el servicio de fondo no llegan mensajes nuevos ni sale lo que apruebes. Reinícialo desde aquí; si no basta, vuelve a vincular."
          }
        }
      }
    },
    "health.whatsapp.version %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puente %@"
          }
        }
      }
    },
    "help.agent.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because you will read it on every screen and in every reply. A proper name makes it easier to talk to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porque lo vas a leer en cada pantalla y en cada respuesta. Un nombre propio hace más fácil hablarle."
          }
        }
      }
    },
    "help.agent.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why give it a name?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué le pongo nombre?"
          }
        }
      }
    },
    "help.agent.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes, up to 60 characters. A short one is quicker to type."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí, hasta 60 caracteres. Uno corto se escribe más rápido."
          }
        }
      }
    },
    "help.agent.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I use any name?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puedo usar cualquier nombre?"
          }
        }
      }
    },
    "help.agent.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the next step, if you want. It is optional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el paso siguiente, si quieres. Es opcional."
          }
        }
      }
    },
    "help.agent.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where do I tell it about my project?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde le cuento de mi proyecto?"
          }
        }
      }
    },
    "help.button" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help for this step"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda de este paso"
          }
        }
      }
    },
    "help.connect.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack requires the connection to go through an app in your own account. First we create it with you, then you authorize it with “Allow”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slack pide que la conexión pase por una app creada en tu cuenta. Primero la creamos contigo y después la autorizas con «Permitir»."
          }
        }
      }
    },
    "help.connect.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why do I sign in twice to Slack?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué inicio sesión dos veces en Slack?"
          }
        }
      }
    },
    "help.connect.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can try again, or skip that tool and connect it later. Nothing is left half-done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes reintentar, o saltar esa herramienta y conectarla después. Nada queda a medias."
          }
        }
      }
    },
    "help.connect.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if something fails?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué pasa si algo falla?"
          }
        }
      }
    },
    "help.connect.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. You sign in on each service’s own page; Galeno doesn’t read or store passwords, and the Slack session is erased when its window closes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Inicias sesión en la página de cada servicio; Galeno no lee ni guarda contraseñas, y la sesión de Slack se borra al cerrar su ventana."
          }
        }
      }
    },
    "help.connect.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does Galeno see my password?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Galeno ve mi contraseña?"
          }
        }
      }
    },
    "help.detection.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic’s app where your agent lives. Galeno sets it up; Claude Code runs it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación de Anthropic donde vive tu agente. Galeno lo prepara; Claude Code lo ejecuta."
          }
        }
      }
    },
    "help.detection.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is Claude Code?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué es Claude Code?"
          }
        }
      }
    },
    "help.detection.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes, when you ask it to. It uses Anthropic’s official installer and does not ask for your Mac password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí, cuando tú lo pides. Usa el instalador oficial de Anthropic y no pide la contraseña de tu Mac."
          }
        }
      }
    },
    "help.detection.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does Galeno install it for me?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Galeno lo instala por mí?"
          }
        }
      }
    },
    "help.detection.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. Galeno opens the page so you can sign in with your Claude account; your password never goes through Galeno."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí. Galeno abre la página para que entres con tu cuenta de Claude; tu contraseña no pasa por Galeno."
          }
        }
      }
    },
    "help.detection.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do I need to be signed in?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Necesito tener la sesión iniciada?"
          }
        }
      }
    },
    "help.done.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open it in the Claude app or in Terminal and write to it, for example with the suggested command."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ábrelo en la app de Claude o en Terminal y escríbele, por ejemplo con el comando sugerido."
          }
        }
      }
    },
    "help.done.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do I talk to my agent?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo hablo con mi agente?"
          }
        }
      }
    },
    "help.done.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a folder with its name inside ~/Galeno. Inside are its AGENTS.md and its memoria/ folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una carpeta con su nombre dentro de ~/Galeno. Dentro están su AGENTS.md y su carpeta memoria/."
          }
        }
      }
    },
    "help.done.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where does it live?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde quedó?"
          }
        }
      }
    },
    "help.done.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes: “Back” takes you to the review and, moving on, the same agent is rewritten without creating another. memoria/ is not touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí: «Atrás» te lleva a la revisión y, al avanzar, se reescribe el mismo agente sin crear otro. memoria/ no se toca."
          }
        }
      }
    },
    "help.done.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I change something later?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puedo cambiar algo después?"
          }
        }
      }
    },
    "help.review.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not until you press “Create …”. Before that you can change any block."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hasta que pulses «Crear a …». Antes puedes cambiar cualquier bloque."
          }
        }
      }
    },
    "help.review.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is anything created now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se crea algo ahora?"
          }
        }
      }
    },
    "help.review.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They live in Claude Code and aren’t touched: only the agent’s folder is created."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viven en Claude Code y no se tocan: solo se crea la carpeta del agente."
          }
        }
      }
    },
    "help.review.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What happens to my connections?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué pasa con mis conexiones?"
          }
        }
      }
    },
    "help.review.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tools you ticked but didn’t connect. You can connect them later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herramientas que marcaste pero no conectaste. Puedes conectarlas más adelante."
          }
        }
      }
    },
    "help.review.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is “For later”?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué es «Para después»?"
          }
        }
      }
    },
    "help.role.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It decides which skills your agent comes with and which tools it suggests first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decide qué skills trae tu agente y qué herramientas te propone primero."
          }
        }
      }
    },
    "help.role.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is the role for?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Para qué sirve el rol?"
          }
        }
      }
    },
    "help.role.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. Each agent has its own role; you can create another one later from the home screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí. Cada agente tiene su rol; puedes crear otro después desde el inicio."
          }
        }
      }
    },
    "help.role.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I have agents with different roles?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puedo tener agentes de roles distintos?"
          }
        }
      }
    },
    "help.role.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the one closest to your day. All three summarize meetings and prepare reports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el que más se parezca a tu día. Los tres resumen reuniones y preparan reportes."
          }
        }
      }
    },
    "help.role.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if I do a bit of everything?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Y si hago un poco de todo?"
          }
        }
      }
    },
    "help.rules.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Anything that goes out to other people (a message, an email) needs your approval, and that can’t be changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Todo lo que sale hacia otras personas (un mensaje, un correo) pide tu aprobación, y eso no se puede cambiar."
          }
        }
      }
    },
    "help.rules.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can my agent send messages without asking me?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puede mi agente enviar mensajes sin pedirme permiso?"
          }
        }
      }
    },
    "help.rules.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That the agent creates and edits inside your tools without telling you first. A draft can be fixed; choose by how much you trust it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que el agente cree y edite dentro de tus herramientas sin avisarte antes. Un borrador se corrige; elige según tu confianza."
          }
        }
      }
    },
    "help.rules.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What does “Don’t ask” change?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué cambia «Sin preguntar»?"
          }
        }
      }
    },
    "help.rules.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only in its memoria/ folder, where it keeps the project notes. It doesn’t run code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en su carpeta memoria/, donde guarda las notas del proyecto. No ejecuta código."
          }
        }
      }
    },
    "help.rules.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where does it write on my computer?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde escribe en mi computador?"
          }
        }
      }
    },
    "help.skills.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A named task your agent runs when you type its command, for example /prd."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tarea con nombre que tu agente ejecuta cuando escribes su comando, por ejemplo /prd."
          }
        }
      }
    },
    "help.skills.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is a skill?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué es una skill?"
          }
        }
      }
    },
    "help.skills.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They need a tool you didn’t connect. They are useful once you have it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitan una herramienta que no conectaste. Sirven cuando la tengas."
          }
        }
      }
    },
    "help.skills.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why are some dimmed?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué algunas salen atenuadas?"
          }
        }
      }
    },
    "help.skills.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skills by other people that we reviewed. Each one carries its author’s credit; for now they are only shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skills de otras personas que revisamos nosotros. Cada una lleva el crédito de su autor; por ahora solo se ven."
          }
        }
      }
    },
    "help.skills.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
