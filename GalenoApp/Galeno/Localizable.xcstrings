    "health.sending.activate.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You linked WhatsApp when Galeno only read it. Read this before turning sending on. Turning it on rewrites the files of the agents that use WhatsApp: anything you edited by hand in them is lost, and their memory is left alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinculaste WhatsApp cuando Galeno solo leía. Lee esto antes de activar los envíos. Al activarlos se vuelven a escribir los archivos de los agentes que usan WhatsApp: lo que hayas editado a mano en ellos se pierde, y su memoria no se toca."
          }
        }
      }
