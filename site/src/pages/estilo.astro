---
// Muestra del sistema de diseño (etapa 1). Es una herramienta de trabajo: se borra antes de abrir el sitio al público
// (`npm run check:launch` falla si sigue en el build). El texto va a mano porque no es contenido del producto.
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import Wordmark from '../components/Wordmark.astro';

const swatches = [
  ['parchment-50', '#F3EEE2', 'Fondo principal'], ['parchment-100', '#EEE7D8', 'Paneles'], ['parchment-200', '#E7E0D1', 'Fondo alterno'],
  ['parchment-300', '#D8D1C1', 'Bordes, código'], ['parchment-400', '#D0CBBC', 'Bordes marcados'],
  ['ink-900', '#2E2D2A', 'Texto principal'], ['ink-700', '#63655E', 'Texto secundario'], ['ink-500', '#8C877C', 'Terciario, decorativo'],
  ['ink-300', '#B5B0A5', 'Divisores, capturas'], ['binding-900', '#314041', 'Hover del botón'],
  ['seal-700', '#8B3A3A', 'Lacre: enlaces y el «.»'], ['seal-100', '#F0E3E0', 'Fondo de avisos'],
  ['moss-700', '#4F6F5B', 'Éxito'], ['ochre-700', '#9A7B2F', 'Advertencia'],
];
---
<Base title="Sistema de diseño" lang="es" route="/estilo" noindex>
  <div class="wrap section">
    <span class="kicker">Etapa 1 · muestra</span>
    <h2>Sistema de diseño del sitio</h2>
    <p class="muted measure">Tokens de <code>docs/04</code> §10, escala de §3, componentes de §6. Cambia el modo claro/oscuro del sistema para ver «el libro de noche».</p>

    <div class="sep">·  ·  ·</div>

    <span class="kicker">Marca</span>
    <div class="brand-row">
      <Portrait size={180} alt="Retrato de Galeno, litografía de Vigneron" eager />
      <div>
        <Wordmark size="lg" />
        <p class="small muted greek" lang="grc">ΓΑΛΗΝΟΥ ΑΠΑΝΤΑ</p>
      </div>
      <Portrait size={34} />
      <Wordmark size="sm" />
    </div>

    <div class="sep">·  ·  ·</div>

    <span class="kicker">Color</span>
    <ul class="swatches">
      {swatches.map(([name, hex, use]) => (
        <li><span class="chipcolor" style={`background:${hex}`}></span><strong>{name}</strong><br /><code>{hex}</code><br /><span class="small muted">{use}</span></li>
      ))}
    </ul>
    <p class="small muted">En oscuro: fondo <code>#141413</code>, paneles <code>#1D1D1B</code>, bordes <code>#302F2C</code>, lacre <code>#B85C5C</code>.</p>

    <div class="sep">·  ·  ·</div>

    <span class="kicker">Tipografía</span>
    <p class="hero-sample">Un asistente que lee tus chats, tickets y documentos, y te deja el trabajo listo.</p>
    <p class="small muted">Titular del hero · EB Garamond 600, grande (una frase no va en capitales).</p>
    <h2>Título de sección en EB Garamond 600</h2>
    <h3>Subsección en EB Garamond 600 · 18</h3>
    <p class="measure">Cuerpo en EB Garamond 400, 18 sobre 1.6, con números antiguos: USD 200, 2026, 1.000 caracteres, macOS 14. La medida es de entre 68 y 74 caracteres, porque la Garamond pide líneas no muy largas. Un <a href="#">enlace en lacre</a> con el subrayado fino, y <strong>texto en negrita</strong> cuando haga falta.</p>
    <p class="small">Texto pequeño, 15 sobre 1.5, para notas y metadatos.</p>
    <p><span class="chip">Fase 3</span> <span class="chip chip--seal">Aviso</span> <span class="chip">Gratis</span></p>
    <pre><code>galeno-whatsapp serve --with-send</code></pre>
    <table>
      <thead><tr><th>Dato</th><th>Valor</th></tr></thead>
      <tbody><tr><td>Precio</td><td>USD 200</td></tr><tr><td>Actualizaciones</td><td>de por vida</td></tr></tbody>
    </table>

    <div class="sep">·  ·  ·</div>

    <span class="kicker">Botones, aviso, panel y captura</span>
    <p class="buttons"><a class="btn btn--primary" href="#">Comprar · USD 200</a> <a class="btn btn--secondary" href="#">Ver cómo funciona</a></p>
    <div class="note measure"><strong>Aviso.</strong> Borde izquierdo de 3 px en lacre y fondo diluido; el acento nunca es un fondo grande.</div>
    <div class="grid2">
      <div class="panel"><h3>Panel</h3><p class="muted">Fondo de panel, borde de 1 px, radio 12. Sin sombra: los bordes separan.</p></div>
      <div class="shot-placeholder">Aquí va una captura real, con borde fino y sin marco de MacBook</div>
    </div>
  </div>
</Base>

<style>
  .brand-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-8); }
  .greek { font-family: var(--font-text); letter-spacing: 0.2em; margin-top: var(--space-2); }
  .swatches { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-4); }
  .chipcolor { display: block; height: 44px; border: 1px solid var(--frame); margin-bottom: var(--space-2); }
  .hero-sample { font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.75rem); line-height: 1.15; font-weight: 600; max-width: 24ch; text-wrap: balance; margin-bottom: var(--space-2); }
  h2 + h3, .small + h2 { margin-top: var(--space-6); }
  h3, .measure + .small, pre, table, .buttons, .note, .grid2 { margin-top: var(--space-4); }
  .buttons { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .grid2 { display: grid; gap: var(--space-6); }
  @media (min-width: 720px) { .grid2 { grid-template-columns: 1fr 1fr; } }
</style>
