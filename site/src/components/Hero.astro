---
import Portrait from './Portrait.astro';
import Wordmark from './Wordmark.astro';
import { t, type Lang } from '../i18n/utils';
import { site } from '../site';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang).home.hero;
---
<section class="hero wrap" aria-labelledby="hero-t">
  <Portrait size={200} alt={tr.portraitAlt} eager />
  <Wordmark size="lg" />
  <h1 id="hero-t">{tr.title}</h1>
  <p class="lead muted">{tr.lead}</p>
  <p class="buttons">
    <a class="btn btn--primary" href={site.checkoutUrl}>{tr.buy}</a>
    <a class="btn btn--secondary" href="#video">{tr.how}</a>
  </p>
  <p class="small muted">{tr.fine}</p>
</section>

<style>
  .hero { display: flex; flex-direction: column; align-items: center; text-align: center; padding-top: var(--space-12); gap: var(--space-6); }
  h1 { font-size: clamp(1.875rem, 1.2rem + 2.8vw, 3rem); line-height: 1.15; font-weight: 600; max-width: 26ch; margin-top: var(--space-4); }
  .lead { max-width: 56ch; }
  .buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-2); }
  .buttons + .small { margin-top: calc(-1 * var(--space-2)); }
</style>
