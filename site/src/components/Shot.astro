---
// Una captura real de la app, con borde fino y sin marcos (docs/04 §7). Las capturas viven en src/assets/shots/
// como `<nombre>-es.png` y `<nombre>-en.png` (o `<nombre>.png` si sirve para los dos idiomas).
// Mientras no exista, se ve un hueco rotulado: `npm run check:launch` falla si queda alguno.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Lang } from '../i18n/utils';

const { name, lang, alt, description } = Astro.props as { name: string; lang: Lang; alt: string; description: string };
const files = import.meta.glob<ImageMetadata>('../assets/shots/*.{png,jpg,jpeg,webp}', { eager: true, import: 'default' });
const find = (base: string) => Object.entries(files).find(([p]) => /\/([^/]+)\.[a-z]+$/.exec(p)?.[1] === base)?.[1];
const image = find(`${name}-${lang}`) ?? find(name);
---
{image ? (
  <Image class="shot" src={image} alt={alt} widths={[560, 840, 1120]} sizes="(min-width: 860px) 520px, 100vw" />
) : (
  <div class="shot-placeholder" data-placeholder="shot">
    <p><span class="kicker">{t(lang).home.shot.pending}</span>{description}</p>
  </div>
)}
