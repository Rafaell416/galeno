---
import Wordmark from './Wordmark.astro';
import Portrait from './Portrait.astro';
import LangSwitch from './LangSwitch.astro';
import { t, path, type Lang } from '../i18n/utils';
const { lang, route = '/' } = Astro.props as { lang: Lang; route?: string };
const tr = t(lang);
import { site } from '../site';
---
<header class="top">
  <div class="wrap bar">
    <a class="brand" href={path(lang, '/')} aria-label="Galeno">
      <Portrait size={34} eager />
      <Wordmark size="sm" />
    </a>
    <nav class="links" aria-label={tr.nav.label}>
      <a href={path(lang, '/#como-funciona')}>{tr.nav.how}</a>
      <a href={path(lang, '/#precio')}>{site.salesOpen ? tr.nav.price : tr.nav.download}</a>
      <a href={path(lang, '/docs')}>{tr.nav.docs}</a>
    </nav>
    <LangSwitch lang={lang} route={route} />
  </div>
</header>

<style>
  .top { border-bottom: 1px solid var(--border); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-6); padding-block: var(--space-3); }
  .brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; margin-right: auto; }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-6); }
  .links a { font-family: var(--font-display); font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-2); text-decoration: none; padding: 10px 0; }
  .links a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 560px) {
    .links { order: 3; width: 100%; justify-content: space-between; }
  }
</style>
