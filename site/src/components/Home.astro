---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import ProductVideo from './ProductVideo.astro';
import Feature from './Feature.astro';
import Separator from './Separator.astro';
import Problem from './Problem.astro';
import Solution from './Solution.astro';
import Steps from './Steps.astro';
import Fit from './Fit.astro';
import Principles from './Principles.astro';
// import Testimonials from './Testimonials.astro';
import Offer from './Offer.astro';
import Faq from './Faq.astro';
import { t, type Lang } from '../i18n/utils';
import { site } from '../site';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const f = tr.home.features;
const features = [
  { id: 'herramientas', key: 'tools', shot: 'herramientas' },
  { id: 'whatsapp', key: 'whatsapp', shot: 'whatsapp' },
  { id: 'documentos', key: 'docs', shot: 'documentos' },
  { id: 'informes', key: 'reports', shot: 'informes' },
] as const;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Galeno',
  description: tr.meta.description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'macOS 14 or later',
  inLanguage: lang,
  ...(site.salesOpen ? { offers: { '@type': 'Offer', price: '200', priceCurrency: 'USD' } } : {}),
  publisher: { '@type': 'Organization', name: site.company, url: site.url },
};
---
<Base title={tr.home.metaTitle} lang={lang} route="/" bareTitle jsonLd={jsonLd}>
  <Hero lang={lang} />
  <Separator />
  <Problem lang={lang} />
  <Separator />
  <Solution lang={lang} />
  <Separator />
  <Steps lang={lang} />
  <Separator />
  <ProductVideo lang={lang} />
  <Separator />
  <div id="como-funciona" class="wrap">
    {features.map((x, i) => {
      const c = f[x.key];
      return (
        <>
          <div class="block">
            <Feature
              id={x.id}
              lang={lang}
              kicker={c.kicker}
              title={c.title}
              body={c.body}
              note={'warning' in c ? { title: c.warningTitle, text: c.warning } : undefined}
              shot={{ name: x.shot, alt: c.shotAlt, description: c.shot }}
              reverse={i % 2 === 1}
            />
          </div>
          {i < features.length - 1 && <div class="gap" />}
        </>
      );
    })}
  </div>
  <Separator />
  <Offer lang={lang} />
  <Separator />
  <Fit lang={lang} />
  {/* Testimonios: apagados hasta que haya reales, aprobados por quien los dio.
      Para encenderlos: descomentar el import de arriba y esta línea, y poner `verified: true` en src/content/testimonials.json.
      <Testimonials lang={lang} /> */}
  <Separator />
  <Principles lang={lang} />
  <Separator />
  <Faq lang={lang} />
</Base>

<style>
  .gap { height: var(--space-24); }
  @media (max-width: 859px) { .gap { height: var(--space-16); } }
</style>
