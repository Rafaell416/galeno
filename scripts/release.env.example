# Copia este archivo a scripts/release.env (no se commitea) y pon tus datos. Aquí NO va ninguna contraseña:
# la de notarización vive en el llavero, guardada con `xcrun notarytool store-credentials` (docs/RELEASE.md).

# El nombre EXACTO del certificado, como lo enseña: security find-identity -v -p codesigning
GALENO_SIGN_IDENTITY="Developer ID Application: Tu Nombre (ABCDE12345)"

# El Team ID: los diez caracteres entre paréntesis del certificado.
GALENO_TEAM_ID="ABCDE12345"

# El nombre del perfil que le diste a notarytool al guardar las credenciales.
GALENO_NOTARY_PROFILE="galeno-notary"

# Sparkle. La cuenta del llavero donde está la clave privada de las actualizaciones (generate_keys --account galeno).
GALENO_SPARKLE_ACCOUNT="galeno"

# De dónde descargarán los clientes cada disco: https, y acabada en /. El appcast apunta ahí.
GALENO_DOWNLOAD_URL_PREFIX="https://tudominio.com/descargas/"
