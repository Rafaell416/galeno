{
  "hooks" : {
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "${CLAUDE_PROJECT_DIR}/.claude/hooks/require-external-approval.sh",
            "type" : "command"
          }
        ],
        "matcher" : "mcp__slack__.*"
      }
    ]
  },
  "permissions" : {
    "allow" : [
      "Edit(/memoria/**)",
      "Glob",
      "Grep",
      "Read",
      "mcp__notion__*",
      "mcp__whatsapp__*"
    ],
    "ask" : [
      "mcp__slack__*"
    ],
    "deny" : [
      "Bash",
      "NotebookEdit",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.mcp.json)",
      "Edit(/.claude/**)"
    ]
  }
}
